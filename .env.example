# Neon connection string. Leave unset for a local PGlite database in .data/pglite
DATABASE_URL=
# Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated emails that become admins on first sign-in
ADMIN_EMAILS=
# Email codes (unset = codes are printed to the server console)
RESEND_API_KEY=
EMAIL_FROM="BFF Navigator <navigator@boulderfeetforward.org>"
# Optional AI assist (TypeSafe Jev)
TYPESAFE_API_KEY=
